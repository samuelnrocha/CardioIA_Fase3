    [ "mpu1:SCL", "esp:22", "yellow", [ "v0" ] ],
    [ "sw_wifi:1", "esp:GND.2", "black", [ "v0" ] ],
    [ "sw_wifi:2", "esp:18", "cyan", [ "v0" ] ],
    [ "sw_wifi:3", "esp:3V3", "red", [ "v0" ] ],
    [ "esp:2", "led_wifi:A", "green", [ "v0" ] ],
