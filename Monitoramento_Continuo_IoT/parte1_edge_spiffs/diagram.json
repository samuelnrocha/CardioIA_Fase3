      "top": -110,
      "left": 170,
      "attrs": {}
    },
    {
      "type": "wokwi-slide-switch",
      "id": "sw_wifi",
      "top": 40,
      "left": 190,
      "attrs": {
        "value": "1"
      }
    },
    {
