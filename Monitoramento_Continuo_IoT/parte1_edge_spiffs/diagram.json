    [ "esp:5", "led_alerta:A", "red", [ "v0" ] ],
    [ "led_alerta:C", "r_alerta:1", "black", [ "v0" ] ],
    [ "r_alerta:2", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
