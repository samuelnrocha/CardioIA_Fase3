        "template_led_alerta"
      ]
    ]
  },
  {
    "id": "template_led_alerta",
    "type": "ui_template",
    "z": "tab_cardioia_fase3",
    "group": "ui_group_alerta",
    "name": "Indicador Visual LED Virtual de Alerta",
    "order": 1,
    "width": "12",
    "height": "3",
    "format": "<div style=\"display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-radius:10px;background:{{msg.payload.alerta ? 'linear-gradient(90deg,#7f1d1d,#991b1b)' : 'linear-gradient(90deg,#064e3b,#065f46)'}};border:2px solid {{msg.payload.alerta ? '#ef4444' : '#10b981'}};color:#fff;font-family:sans-serif;\">\n  <div style=\"display:flex;align-items:center;gap:16px;\">\n    <div style=\"width:28px;height:28px;border-radius:50%;background:{{msg.payload.alerta ? '#ff2e2e' : '#10b981'}};box-shadow:0 0 18px {{msg.payload.alerta ? '#ff2e2e' : '#10b981'}};\"></div>\n    <div>\n      <div style=\"font-size:18px;font-weight:700;letter-spacing:0.5px;\">{{msg.payload.titulo || 'AGUARDANDO TELEMETRIA MQTT...'}}</div>\n      <div style=\"font-size:14px;opacity:0.92;margin-top:4px;\">Diagnóstico de Borda: <strong>{{msg.payload.detalhe || 'Conectado ao broker.hivemq.com'}}</strong></div>\n    </div>\n  </div>\n  <div style=\"text-align:right;font-size:13px;opacity:0.9;\">\n    <div>Pacote #{{msg.payload.seq || 0}} | Modo: <strong>{{msg.payload.origem || 'MQTT'}}</strong></div>\n    <div style=\"margin-top:4px;\">Limites: BPM &gt; 120 | Temp &gt; 38.0 °C</div>\n  </div>\n</div>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 850,
    "y": 360,
    "wires": [
