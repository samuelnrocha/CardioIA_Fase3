  {
    "id": "inject_alerta",
    "type": "inject",
    "z": "tab_cardioia_fase3",
    "name": "Simular Alerta Crítico (138 BPM / 38.7°C)",
    "props": [
      {
        "p": "payload"
      }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"paciente_id\":\"PAC-001\",\"paciente\":\"Ana Beatriz Souza\",\"seq\":102,\"timestamp_ms\":306000,\"temperatura_c\":38.7,\"umidade_pct\":64.5,\"bpm\":138,\"aceleracao_g\":1.00,\"em_movimento\":false,\"alerta_critico\":true,\"nivel_risco\":\"CRITICO\",\"diagnostico_borda\":\"ALERTA_COMBINADO_TAQUICARDIA_E_FEBRE\",\"origem_envio\":\"TEMPO_REAL\"}",
    "payloadType": "json",
    "x": 200,
    "y": 300,
    "wires": [
      [
        "fn_processar_sinais"
      ]
    ]
  },
  {
    "id": "fn_processar_sinais",
    "type": "function",
    "z": "tab_cardioia_fase3",
    "name": "Processador Fog & Motor de Alertas",
    "func": "const d = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n\nconst bpm = Number(d.bpm || 75);\nconst temp = Number(d.temperatura_c || 36.5);\nconst umid = Number(d.umidade_pct || 55.0);\nconst accel = Number(d.aceleracao_g || 1.0);\nconst mov = Boolean(d.em_movimento !== undefined ? d.em_movimento : true);\n\n// Avaliação de limites clínicos definidos pelo grupo\nconst motivos = [];\nif (bpm > 120) motivos.push(`Taquicardia (${bpm} BPM > 120)`);\nif (bpm < 50) motivos.push(`Bradicardia (${bpm} BPM < 50)`);\nif (temp > 38.0) motivos.push(`Febre/Hipertermia (${temp.toFixed(1)} °C > 38°C)`);\nif (temp < 35.0) motivos.push(`Hipotermia (${temp.toFixed(1)} °C < 35°C)`);\nif (!mov && (bpm > 105 || bpm < 55)) motivos.push('Ausência de Movimento com Alteração Cardíaca');\n\nconst emAlerta = Boolean(d.alerta_critico) || motivos.length > 0;\nconst textoMotivo = motivos.length > 0 ? motivos.join(' + ') : (d.diagnostico_borda || 'SINAIS_ESTAVEIS');\n\nconst msgBpm = { payload: bpm, topic: 'Batimentos (BPM)' };\nconst msgTemp = { payload: temp, topic: 'Temperatura (°C)' };\nconst msgUmid = { payload: umid, topic: 'Umidade (%)' };\nconst msgAccel = { payload: accel, topic: 'Aceleração (G)' };\nconst msgPaciente = { payload: `${d.paciente || 'Ana Beatriz Souza'} (${d.paciente_id || 'PAC-001'}) | Origem: ${d.origem_envio || 'TEMPO_REAL'}` };\nconst msgMovimento = { payload: mov ? 'EM MOVIMENTO (Ativo)' : 'PARADO / IMÓVEL (Atenção)' };\n\nconst msgLedTemplate = {\n    payload: {\n        alerta: emAlerta,\n        titulo: emAlerta ? 'ALERTA CLÍNICO CRÍTICO ATIVO' : 'MONITORAMENTO NORMAL — SINAIS ESTÁVEIS',\n        detalhe: textoMotivo,\n        bpm: bpm,\n        temp: temp.toFixed(1),\n        umid: umid.toFixed(1),\n        mov: mov ? 'Ativo' : 'Imóvel',\n        origem: d.origem_envio || 'TEMPO_REAL',\n        seq: d.seq || 1\n    }\n};\n\nreturn [msgBpm, msgTemp, msgUmid, msgAccel, msgPaciente, msgMovimento, msgLedTemplate];",
    "outputs": 7,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 520,
    "y": 200,
    "wires": [
      [
        "gauge_bpm",
        "chart_bpm"
      ],
      [
        "gauge_temp",
        "chart_temp"
      ],
      [
        "gauge_umid"
      ],
      [
        "gauge_accel"
      ],
      [
        "text_paciente"
      ],
      [
        "text_movimento"
      ],
